# Build basil with basil (dogfood). The builder is a static-musl Rust image
# (rust:alpine targets musl by default), so the deliverable runs on `scratch`.

# --- static builder ---
FROM rust:1.88-alpine@sha256:9dfaae478ecd298b6b5a039e1f2cc4fc040fc818a2de9aa78fa714dea036574d AS builder
ARG VERSION=""
WORKDIR /src
COPY Cargo.toml Cargo.lock .
# A placeholder target so `cargo fetch` can resolve the manifest before the
# real sources are copied in (cargo needs a lib/main to pick a target).
RUN mkdir -p src/main && echo 'fn main() {}' > src/main.rs && cargo fetch
COPY . .
# ring/other native crates need the musl C toolchain + headers.
RUN apk add --no-cache musl-dev gcc binutils
RUN cargo build --release --bin basil

# --- deliverable: the static binary on scratch ---
FROM scratch AS 127.0.0.1:5001/basil
COPY --from=builder /src/target/release/basil /basil
ENV PATH=/usr/local/bin:/usr/bin:/bin
ENTRYPOINT ["/basil"]

# Build on every push to main.
ON push(main) BUILD 127.0.0.1:5001/basil
